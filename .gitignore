# OSCAR — Git Ignore Rules
# Strictly excludes dependencies, environment credentials, build artifacts, test coverage, and local cache.

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables & local secrets (CRITICAL FOR CONFIDENTIALITY)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
*.pem
*.key
*.cert

# Build outputs & caches
dist/
build/
out/
.vite/
.cache/
*.tsbuildinfo

# Test & Coverage artifacts
coverage/
.vitest/
.nyc_output/

# Runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Firebase CLI & Emulator artifacts
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# OS & Editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
