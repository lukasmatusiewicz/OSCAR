{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@oscar/shared": ["../shared/src/index.ts"],
      "@oscar/shared/*": ["../shared/src/*"],
      "zod": ["./node_modules/zod/index.d.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "../shared/src/**/*"]
}
