# ==============================================================================
# OSCAR Runtime Environment Configuration Template
# Copy this file to .env and configure local secret credentials.
# ==============================================================================

# Google Gemini API Key (Obtained from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Express Server Port Configuration
PORT=3000

# Server Runtime Environment (development | test | production)
NODE_ENV=development

# Permitted CORS Origin for Frontend Client Access
CORS_ORIGIN=http://localhost:5173

# Server Structured Logger Minimum Log Level
# Permitted values: debug | info | warn | error (case-insensitive)
LOG_LEVEL=info

# Client Structured Logger Minimum Log Level
# Permitted values: debug | info | warn | error (case-insensitive)
VITE_LOG_LEVEL=info
